;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6087;exitDx=0;exitDy=0;entryX=0;entryY=0.6087;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin7i" value="(A8) new user details" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6522;exitDx=0;exitDy=0;entryX=1;entryY=0.6522;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin7o" value="account created" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6957;exitDx=0;exitDy=0;entryX=0;entryY=0.6957;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin8i" value="(A9) updated user details / status" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7391;exitDx=0;exitDy=0;entryX=1;entryY=0.7391;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin8o" value="update confirmation" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7826;exitDx=0;exitDy=0;entryX=0;entryY=0.7826;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin9i" value="(A10) report type and date range" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8261;exitDx=0;exitDy=0;entryX=1;entryY=0.8261;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin9o" value="stock report (PDF)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8696;exitDx=0;exitDy=0;entryX=0;entryY=0.8696;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin10i" value="(A11) audit filters" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0;exitY=0.913;exitDx=0;exitDy=0;entryX=1;entryY=0.913;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="admin10o" value="audit trail records" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9565;exitDx=0;exitDy=0;entryX=0;entryY=0.9565;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="admin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="llm" value="LLM Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontStyle=1;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="640" y="1230" width="360" height="70" as="geometry"/></mxCell><mxCell id="llmo" value="question text" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="llmi" value="search terms" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Use cases per actor&lt;/b&gt;&lt;br&gt;Staff (S1–S7): Login, Record Stock-In, Record Stock-Out, Record Stock Adjustment, Search Stock and Location, View Low-Stock Alerts, Ask Stock Assistant = &lt;b&gt;7&lt;/b&gt;&lt;br&gt;Administrator (A1–A11): Add/Edit Product, Add Category, Add/Edit Supplier, Add/Edit Location, Add/Edit User, Generate Report, View Audit Trail = &lt;b&gt;11&lt;/b&gt; (+ inherits the 7 Staff use cases)&lt;br&gt;Each numbered arrow is one use case; the unnumbered arrow below it is its output." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="60" y="1220" width="560" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="DFD - Level 0" id="pg140209125197296"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1424" value="Figure 3.X: Level 0 Data Flow Diagram of the AI-Assisted Inventory System" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c1425" value="&lt;b&gt;1.0&lt;/b&gt;&lt;hr&gt;Authenticate User" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="200" height="90" as="geometry"/></mxCell><mxCell id="c1426" value="&lt;b&gt;2.0&lt;/b&gt;&lt;hr&gt;Manage Master Data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="200" height="90" as="geometry"/></mxCell><mxCel