=1;" edge="1" parent="1" source="c436" target="c431"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c452" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c436" target="c433"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c453" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c436" target="c434"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c454" value="" style="endArrow=block;endFill=0;endSize=14;html=1;" edge="1" parent="1" source="c436" target="c435"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c455" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="c412" target="c415"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c456" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="c413" target="c415"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c457" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="c414" target="c415"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c458" value="«extend»&lt;br&gt;[quantity ≤ reorder level]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="c416" target="c413"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c459" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="c416" target="c414"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c460" value="«extend»&lt;br&gt;[no barcode: code saved as barcode]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="c428" target="c421"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c461" value="Notes:&lt;br&gt;• Administrator inherits every Staff use case.&lt;br&gt;• All use cases except Login require a logged-in user.&lt;br&gt;• 18 use cases are started by an actor; each has one activity diagram and one sequence diagram.&lt;br&gt;• Edit Supplier and Edit User include setting the status to inactive.&lt;br&gt;• Ask Stock Assistant is read-only; the LLM service only interprets the question." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="270" height="200" as="geometry"/></mxCell><mxCell id="c900" value="Ask Stock Assistant" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="320" y="682" width="250" height="56" as="geometry"/></mxCell><mxCell id="c901" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c435" target="c900"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c902" value="Use cases per actor:&lt;br&gt;&lt;b&gt;Staff:&lt;/b&gt; 7 lines (Login, Record Stock-In, Record Stock-Out, Record Stock Adjustment, Search Stock and Location, View Low-Stock Alerts, Ask Stock Assistant)&lt;br&gt;&lt;b&gt;Administrator:&lt;/b&gt; 11 own lines (Add/Edit Product, Add Category, Add/Edit Supplier, Add/Edit Location, Add/Edit User, Generate Report, View Audit Trail) + 7 inherited from Staff = 18&lt;br&gt;Included/extending use cases (no actor line): Scan Barcode / QR Code, Generate Low-Stock Alert, Generate QR Label" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1060" y="310" width="270" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Class Diagram" id="pg140209136555408"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c44" value="Figure 3.X: Class Diagram of the Web-Based Inventory Management System" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c45" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- userId : int&lt;br&gt;- name : String&lt;br&gt;- email : String&lt;br&gt;- passwordHash : String&lt;br&gt;- role : String&lt;br&gt;- status : String&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ login() : boolean&lt;br&gt;+ logout() : void&lt;br&gt;+ changePassword() : void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Times New Roman;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="220" height="181" as="geometry"/></mxCell><mxCell id="c46" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Administrator&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ manageUser() : void&lt;br&gt;+ manageProduct() : void&lt;br&gt;+ manageLocation() : void&lt;br&gt;+ manageSupplier() : void&lt;br&gt;+ generateReport() : Report&lt;br&gt;+ viewAuditTrail() : void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Times New Roman;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="200" height="136" as="geometry"/></mxCell><mxCell id="c47" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Staff&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ scanItem(code) : Product&lt;br&gt;+ stockIn() : void&lt;br&gt;+ stockOut() : void&lt;br&gt;+ adjustStock() : void&lt;br&gt;+ searchItem() : void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Times New Roman;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="190" height="121" as="geometry"/></mxCell><mxCell id="c48" value="" style="endArrow=block;endFill=0;endSize=14;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="" style="endArrow=block;endFill=0;endSize=14;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c47" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Category&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- categoryId : int&lt;br&gt;- name : String&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ addCategory() : void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Times New Roman;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="190" height="91" as="geometry"/></mxCell><mxCell id="c51" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Supplier&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- supplierId : int&lt;br&gt;- name : String&lt;br&gt