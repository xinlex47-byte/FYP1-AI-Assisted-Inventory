 target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="staff2o" value="stock-out confirmation / insufficient stock" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="staff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="staff3i" value="(S4) scanned part code, counted quantity, reason" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4667;exitDx=0;exitDy=0;entryX=0;entryY=0.4667;entryDx=0;entryDy=0;" edge="1" parent="1" source="staff" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="staff3o" value="adjustment confirmation" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5333;exitDx=0;exitDy=0;entryX=1;entryY=0.5333;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="staff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="staff4i" value="(S5) keyword, part number, vehicle model or scanned code" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="staff" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="staff4o" value="stock quantity and shelf location" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;fontFamily=Times New Roman;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6667;exitDx=0;exitDy=0;entryX=1;entryY=0.6667;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="staff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="staff5i" value="(S6) alert view request" style="endArrow=block;endFill=1;html=1;rounded=0;font